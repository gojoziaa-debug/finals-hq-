# Connexion Postgres (Supabase) pour l'ingestion : pooler en mode transaction, port 6543.
# Ne jamais commiter la vraie valeur ; en CI c'est le secret GitHub Actions DATABASE_URL.
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Connexion pour les migrations : pooler en mode session, port 5432 (l'hôte direct db.<ref>.supabase.co
# est IPv6 uniquement sur l'offre gratuite, inutilisable depuis GitHub Actions). Secret DIRECT_URL en CI.
DIRECT_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Chemin local d'un checkout de gojoziaa-debug/finals-hq-data (dossiers state/, archive/, seasons/).
DATA_ROOT=../../data

# Jours de rs_events conservés (partitions journalières supprimées en fin de passage). 8 = delta_7d + marge.
RS_EVENTS_KEEP_DAYS=8
