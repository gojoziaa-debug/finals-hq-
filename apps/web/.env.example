# Lecture de la base (le site ne fait que des SELECT). Pooler Supabase en mode transaction, port 6543 :
# même valeur que le secret DATABASE_URL du worker. Sur Vercel : Settings → Environment Variables.
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Adresse publique du site (balises canonical, Open Graph). Facultatif sur Vercel : l'URL de production est déduite.
NEXT_PUBLIC_SITE_URL=

# Sentry (facultatif : sans DSN, rien n'est envoyé ni chargé).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Envoi des source maps au build (facultatif) : jeton d'organisation Sentry, scope project:releases.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# 1 pour servir /styleguide en production (servie d'office en développement et sur les prévisualisations Vercel).
HQ_STYLEGUIDE=

# Identité de l'éditeur, affichée sur /legal et /privacy (obligatoire avant le lancement, RGPD). Jamais dans le dépôt :
# variables Vercel (Production et Preview). LEGAL_LOCATION : ville et pays, par exemple « Liège, Belgique ».
LEGAL_NAME=
LEGAL_EMAIL=
LEGAL_LOCATION=

# 1 pour forcer l'indexation par les moteurs (sinon : production sur le domaine définitif seulement).
HQ_INDEX=
